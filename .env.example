# Supabase (from your project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Earth Engine (pipeline)
GEE_PROJECT=ucip-mum

# Upstash Redis, for API rate limiting (issue #101). Optional: with these unset
# the limiter is inert and every request passes, which is how the code ships
# before the store exists. Set both to turn enforcement on.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog analytics. Optional: leave both commented out for local development and the
# site runs without analytics. An empty value counts as unset, so do not leave blanks.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=
