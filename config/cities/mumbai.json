{
  "$schema": "../city.schema.json",
  "slug": "mumbai",
  "name": "Mumbai",
  "country": "India",
  "timezone": "Asia/Kolkata",

  "bbox": [72.7, 18.8, 73.0, 19.3],

  "boundaries": {
    "file": "bmc_wards.geojson",
